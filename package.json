{
  "name": "@sassoninc/album-engine-core",
  "version": "0.1.0",
  "description": "Generic, RTL-first React rendering engine for digital congratulatory albums (page-flip, slider, grid).",
  "license": "MIT",
  "author": "Kfir Sasson <kfir.sasson@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kfirs/hebrew-album-engine.git"
  },
  "homepage": "https://github.com/kfirs/hebrew-album-engine#readme",
  "bugs": "https://github.com/kfirs/hebrew-album-engine/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/album-engine-core.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "page-flip": "^2.0.7",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "keywords": [
    "album",
    "rtl",
    "hebrew",
    "page-flip",
    "swiper",
    "react"
  ]
}
